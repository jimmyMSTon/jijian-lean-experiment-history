    "statement": "∀ (f : ℝ → ℝ) (L : ℝ), 0 ≤ L → (∀ x y : ℝ, |f x - f y| ≤ L * |x - y|) → ∀ ε : ℝ, 0 < ε → ∃ δ : ℝ, 0 < δ ∧ (∀ x y : ℝ, |x - y| < δ → |f x - f y| < ε)",
    "proofTerm": "by\n  intro f L hL hLip ε hε\n  let δ : ℝ := ε / (L + 1)\n  have source_step_0 : 0 < ε := hε\n  have source_step_1 : δ = ε / (L + 1) := rfl\n  have source_step_2 : 0 < L + 1 ∧ 0 < δ := by\n    constructor\n    · linarith\n    · rw [show δ = ε / (L + 1) by rfl]\n      exact div_pos hε (by linarith)\n  have source_step_8 : ∀ x y : ℝ, |x - y| < δ → |f x - f y| < ε := by\n    intro x y hxy\n    have source_step_3 : |x - y| < δ := hxy\n    have source_step_4 : |f x - f y| ≤ L * |x - y| := hLip x y\n    have source_step_5 : L * |x - y| ≤ (L + 1) * |x - y| := by\n      have hnonneg : 0 ≤ |x - y| := abs_nonneg (x - y)\n      have hLle : L ≤ L + 1 := by linarith\n      exact mul_le_mul_of_nonneg_right hLle hnonneg\n    have source_step_6 : (L + 1) * |x - y| < (L + 1) * δ ∧ (L + 1) * δ = ε := by\n      constructor\n      · exact mul_lt_mul_of_pos_left hxy source_step_2.1\n      · have hL1ne : L + 1 ≠ 0 := ne_of_gt source_step_2.1\n        rw [source_step_1]\n        field_simp [hL1ne]\n        try ring\n    have source_step_7 : |f x - f y| < ε := by\n      calc\n        |f x - f y| ≤ L * |x - y| := source_step_4\n        _ ≤ (L + 1) * |x - y| := source_step_5\n        _ < (L + 1) * δ := source_step_6.1\n        _ = ε := source_step_6.2\n    exact source_step_7\n  have source_step_9 : ∃ δ : ℝ, 0 < δ ∧ (∀ x y : ℝ, |x - y| < δ → |f x - f y| < ε) :=\n    ⟨δ, source_step_2.2, source_step_8⟩\n  exact source_step_9",
