    async def repair_locked_proof(*, source: str, step: dict, statement: str,
                                  original_proof: str, first_lean: dict, provider, runner,
                                  emit=None, proof_validator=None,
                                  mandatory_source_markers: list[str] | None = None) -> dict:
        """Continue technical correction while Lean supplies novel diagnostics.
    
        There is no arbitrary retry count. The existing fixed theorem, source-step
        witnesses, provenance, and fresh Kernel check apply to EVERY candidate.
        A repeated proof, identical diagnostics, refusal, malformed reply, source
        witness loss, or genuine service failure can never become a success.
        Mathematical gaps are never repaired by inventing author reasoning.
        """
        from .errors import AppError
    
        attempts = [{"origin": "original_translation", "proofTerm": original_proof,
                     "lean": first_lean, "kernelVerified": kernel_pass(first_lean)}]
        record = {"attempts": attempts, "candidateProofTerm": original_proof,
                  "lean": first_lean, "kernelVerified": False, "repairStatus": "not_attempted"}
        current_proof, current_lean = original_proof, first_lean
        seen_proofs = {original_proof}
        while True:
            if current_lean.get('status') in ('statement_not_elaborated', 'missing_proof'):
                record['repairStatus'] = 'fixed_statement_not_elaborated_or_missing_proof'
                return record
            diagnostics = current_lean.get('diagnostics') or []
            if not any(d.get('severity') == 'error' for d in diagnostics):
                if len(attempts) == 1:
                    record['repairStatus'] = 'no_actionable_lean_error'
                return record
            if emit is not None:
                await emit('local_repairing', {"stepId": step['id'],
                                               "completedAttempts": len(attempts) - 1})
            api_evidence = await checked_missing_name_evidence(diagnostics, runner)
            if api_evidence.get('missingNames'):
                record.setdefault('mathlibDeclarationChecks', []).append(api_evidence)
            try:
                reply, provenance = await provider.structured(LockedProofRepair, PROMPT, {
                    'originalSource': source,
                    'sourceSpan': {k: step[k] for k in ('id', 'start', 'end', 'sourceExcerpt')},
                    'lockedFormalStatement': statement,
                    'originalTranslationProofTerm': current_proof,
                    'leanStatus': current_lean.get('status'),
                    'leanDiagnostics': diagnostics,
                    'lockedDependencies': step.get('dependsOn') or [],
                    'unverifiedDependencies': step.get('unverifiedDependencyIndices') or [],
                    'mandatorySourceMarkers': mandatory_source_markers or [],
                    'installedMathlibDeclarationEvidence': api_evidence,
                })
            except AppError as error:
                record['repairStatus'] = 'repair_service_unavailable'
                record['repairServiceError'] = error.payload()
                return record
            candidate = reply.proofTerm
            record['repairProvenance'] = provenance
            record['repairNote'] = reply.repairNote
            if candidate in seen_proofs:
                record['repairStatus'] = 'repair_declined_or_unchanged' if candidate == current_proof else 'repair_repeated_previous_candidate'
                return record
            invalid = invalid_translation(statement, candidate)
            if invalid:
                record['repairStatus'] = 'repair_invalid_lean_translation'
                record['repairRejectionReason'] = invalid
                record['rejectedProofTerm'] = candidate
                return record
            if proof_validator is not None:
