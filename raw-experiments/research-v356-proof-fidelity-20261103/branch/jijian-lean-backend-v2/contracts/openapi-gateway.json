    "/internal/ocr/{action}": {
      "post": {
        "summary": "Gateway Ocr",
        "operationId": "gateway_ocr_internal_ocr__action__post",
        "parameters": [
          {
            "name": "action",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Action"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
