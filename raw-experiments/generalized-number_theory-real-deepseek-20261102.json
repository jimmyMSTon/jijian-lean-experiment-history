  "statement": "∀ n : ℕ, Even n → Even (n ^ 2)",
  "proofTerm": "by\n  intro n hn\n  have source_step_0 : ∃ k : ℕ, n = 2 * k := by\n    rcases hn with ⟨k, hk⟩\n    refine ⟨k, ?_⟩\n    omega\n  rcases source_step_0 with ⟨k, hk⟩\n  have source_step_1 : n ^ 2 = 2 * (2 * k ^ 2) := by\n    rw [hk]\n    ring\n  have source_step_2 : Even (n ^ 2) := by\n    rw [even_iff_two_dvd]\n    exact ⟨2 * k ^ 2, source_step_1⟩\n  exact source_step_2",
