{
  "id": "dcf8338f-5490-4f94-93fb-8406c74b5e7c",
  "runId": "573cdff4-45e8-4f08-853b-a15a47897af9",
  "kind": "lean_first_explanation_only",
  "verifiedFormalProof": false,
  "sourceEquivalenceCertified": false,
  "originalProofCertified": false,
  "modelExplanationAuthority": "interpretation_only_not_a_certificate",
  "formalProofCertified": false,
  "verificationMode": "single_whole_theorem_kernel",
  "sourceFidelityReview": {},
  "authoredClaimRefutation": {},
