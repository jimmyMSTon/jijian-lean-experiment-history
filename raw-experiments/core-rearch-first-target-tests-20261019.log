ir = MathIRV2(version='2.0', source=SourceEvidence(id='s', kind='text', raw='1=1', normalized='1=1', blocks=[SourceBlock(id...laim_goal', inductions=[], sourceRefs=[], sourceAssessment='supported', assessmentBasis='test route')], ambiguities=[])

    async def complete_and_verify_proof_routes(provider, ir: MathIRV2, *, runner,
                                                lock: ProofLock | None = None,
                                                retriever=None,
                                                previously_generated_terms: dict[str, str] | None = None,
                                                emit: Callable[[str, dict[str, Any]], Awaitable[None]] | None = None,
                                                checkpoint: Callable[[dict[str, Any]], Awaitable[None]] | None = None,
                                                ) -> ProofWorkflowResult:
        """Generate missing terms, verify all routes, and repair new Lean evidence.
    
        The loop ends on route success, no patch, a patch that changes no term, or
        recurrence of the same mathematical verification state. Proof spelling
        alone is not progress. It has no arbitrary retry/round count. A changed
        proof is always checked against the same lock and followed by verification
        of the entire original route.
        """
        compiled = compile_v2(ir)
        lock = lock or create_proof_lock(ir, compiled)
        if compiled.statement_hash != lock.statement_hash:
            raise ValueError("PROOF_LOCK_CHANGED: initial theorem statement differs")
        # A caller may resume a saved AI-generated proof only when it can provide
        # its provenance. The exact term must still be present in the locked MathIR;
        # user-authored pre-existing proofs stay protected by default.
        prior_generated = dict(previously_generated_terms or {})
        current_terms = {node.id: node.proofTerm for route in ir.proofRoutes
                         for node in route.nodes if node.proofTerm is not None}
        # Task-local immutable-identity reuse: unchanged proof obligations need
        # no repeated Lean subprocess during repair. Changes always recheck.
        verified_step_cache: dict[str, dict[str, Any]] = {}
        proof_term_origins = {node_id: "preexisting" for node_id in current_terms}
        for node_id, proof_term in prior_generated.items():
            if current_terms.get(node_id) != proof_term:
                raise ValueError(f"PRIOR_GENERATED_PROOF_MISMATCH: {node_id}")
            proof_term_origins[node_id] = "previously_generated"
    
        events: list[WorkflowEvent] = []
        retrieval_records: list[dict[str, Any]] = []
        retrieval_scopes: list[dict[str, Any]] = []
        seen_retrieval_inputs: set[str] = set()
        seen_retrieval_records: set[str] = set()
    
        async def persist_checkpoint(snapshot: dict[str, Any]) -> None:
            if checkpoint is None:
                return
            try:
                await checkpoint(snapshot)
            except Exception as error:
                # Checkpointing is secondary to the verification result. Record its
                # failure without replacing the current Lean/Kernel conclusion.
                events.append(WorkflowEvent("checkpoint_persistence_failed", False, None, (),
                    _sha({"stage": snapshot.get("stage"), "error": type(error).__name__}),
                    {"stage": snapshot.get("stage"), "errorType": type(error).__name__}))
                if emit:
                    try:
                        await emit("checkpoint_persistence_failed", {
                            "stage": snapshot.get("stage"), "errorType": type(error).__name__})
                    except Exception:
                        pass
    
        async def append_event(event: WorkflowEvent) -> None:
            events.append(event)
            if checkpoint:
                await persist_checkpoint({
                    "stage": event.stage,
                    "mathIR": ir.model_dump(mode="json"),
                    "statementHash": lock.statement_hash,
                    "verification": verification,
                    "verificationHistory": list(verification_history),
                    "events": [_checkpoint_event(row) for row in events],
                    "mathlibRetrievalRecords": list(retrieval_records),
                    "mathlibRetrievalScopes": list(retrieval_scopes),
                    "termination": "in_progress",
                })
            if emit:
                patch_rows = event.patch_records
                provider = event.provider or {}
                await emit(event.stage, {
                    "providerCalled": event.provider_called,
                    "requestId": provider.get("request_id"),
                    "responseId": provider.get("response_id"),
                    "model": provider.get("model"),
                    "usage": provider.get("usage"),
                    "inputHash": event.repair_input_hash,
                    "nodeIds": [row.get("node_id") for row in patch_rows],
                    "result": event.result,
                })
    
        async def report_verification(value: dict, ordinal: int) -> None:
            if checkpoint:
                await persist_checkpoint({
                    "stage": "lean_verification",
                    "mathIR": ir.model_dump(mode="json"),
                    "statementHash": lock.statement_hash,
                    "verification": value,
                    "verificationHistory": list(verification_history),
                    "events": [_checkpoint_event(row) for row in events],
                    "mathlibRetrievalRecords": list(retrieval_records),
                    "mathlibRetrievalScopes": list(retrieval_scopes),
                    "termination": "in_progress",
                })
            if emit:
                await emit("lean_verification", {
                    "verificationIndex": ordinal,
                    "fixedStatementKernelPassed": value.get("fixedStatementKernelPassed"),
                    "originalRouteKernelPassed": value.get("anyRouteKernelPassed"),
                    "originalMeaning": value.get("originalMeaning"),
                    "unresolvedAmbiguityIds": value.get("unresolvedAmbiguityIds", []),
                    "routes": [{"routeId": route.get("routeId"),
                                "status": route.get("status"),
                                "proofComposition": route.get("proofComposition"),
                                "dependencyEvidence": route.get("dependencyEvidence")}
                               for route in value.get("routes", [])],
                })
    
        async def retrieve_mathlib(task: dict, stage: str, *, repair_state: str,
                                   repairs: list[dict[str, Any]]) -> None:
            if retriever is None:
                return
            task_hash = _sha(task)
            if task_hash in seen_retrieval_inputs:
                return
            seen_retrieval_inputs.add(task_hash)
            retrieval = await retriever.context(task)
            # Archive distinct records even when their checked context hash is the
