        ],
        "statement": "∀ x : ℝ, (0 ≤ (⨅ k : ℤ, |x - (k : ℝ)|) ∧ (⨅ k : ℤ, |x - (k : ℝ)|) ≤ (1 / 2 : ℝ)) ∧ ∀ k : ℤ, (⨅ j : ℤ, |(x + (k : ℝ)) - (j : ℝ)|) = (⨅ j : ℤ, |x - (j : ℝ)|)",
        "proofTerm": "",
