  "summary": "整篇形式证明尚未通过 Lean Kernel；请查看原稿锚点、编译诊断和翻译缺口，不能据此判定原数学证明错误。",
  "sourceSteps": [
    {
      "id": "source-0",
      "index": 0,
      "role": "inference",
      "start": 152,
      "end": 164,
      "sourceExcerpt": "第一步：假设结论不成立。",
      "status": "translation_mapped_only",
      "kernelVerified": false,
      "sourcePositionsValid": true,
      "originalInferenceVerified": false,
      "sourceEquivalenceCertified": false,
      "leanWitnessMarker": "source_step_0",
      "dependsOn": []
    },
    {
      "id": "source-1",
      "index": 1,
      "role": "inference",
      "start": 165,
      "end": 205,
      "sourceExcerpt": "假设 ∑_{i=1}^k xᵢ<1。记 t=∑_{i=1}^k xᵢ，u=xₖ。",
      "status": "translation_mapped_only",
      "kernelVerified": false,
      "sourcePositionsValid": true,
      "originalInferenceVerified": false,
      "sourceEquivalenceCertified": false,
      "leanWitnessMarker": "source_step_1",
      "dependsOn": []
    },
    {
      "id": "source-2",
      "index": 2,
      "role": "inference",
      "start": 206,
      "end": 231,
      "sourceExcerpt": "由条件可知 0≤u≤xᵢ≤t<1 (1≤i≤k)。",
      "status": "translation_mapped_only",
      "kernelVerified": false,
      "sourcePositionsValid": true,
      "originalInferenceVerified": false,
      "sourceEquivalenceCertified": false,
      "leanWitnessMarker": "source_step_2",
      "dependsOn": []
    },
    {
      "id": "source-3",
      "index": 3,
      "role": "inference",
      "start": 232,
      "end": 262,
      "sourceExcerpt": "另一方面，由数列的单调性，0≤xᵢ≤u<1 (k<i≤n)。",
      "status": "translation_mapped_only",
      "kernelVerified": false,
      "sourcePositionsValid": true,
      "originalInferenceVerified": false,
      "sourceEquivalenceCertified": false,
      "leanWitnessMarker": "source_step_3",
      "dependsOn": []
    },
    {
      "id": "source-4",
      "index": 4,
      "role": "inference",
      "start": 283,
      "end": 320,
      "sourceExcerpt": "对任意 1≤i≤k，由于 0≤xᵢ<1，且 m≥2，有 xᵢ^m≤xᵢ²。",
      "status": "translation_mapped_only",
      "kernelVerified": false,
      "sourcePositionsValid": true,
      "originalInferenceVerified": false,
      "sourceEquivalenceCertified": false,
      "leanWitnessMarker": "source_step_4",
      "dependsOn": []
    },
    {
      "id": "source-5",
      "index": 5,
      "role": "inference",
      "start": 321,
      "end": 350,
      "sourceExcerpt": "又因为 u≤xᵢ<1，所以 (xᵢ−u)(1−xᵢ)≥0。",
      "status": "translation_mapped_only",
      "kernelVerified": false,
      "sourcePositionsValid": true,
      "originalInferenceVerified": false,
      "sourceEquivalenceCertified": false,
      "leanWitnessMarker": "source_step_5",
      "dependsOn": []
    },
    {
      "id": "source-6",
      "index": 6,
      "role": "inference",
      "start": 351,
      "end": 372,
      "sourceExcerpt": "展开并整理，得 xᵢ²≤xᵢ−u+uxᵢ。",
      "status": "translation_mapped_only",
      "kernelVerified": false,
      "sourcePositionsValid": true,
      "originalInferenceVerified": false,
      "sourceEquivalenceCertified": false,
      "leanWitnessMarker": "source_step_6",
      "dependsOn": []
    },
    {
      "id": "source-7",
      "index": 7,
      "role": "inference",
      "start": 373,
      "end": 390,
      "sourceExcerpt": "因此 xᵢ^m≤xᵢ−u+uxᵢ。",
      "status": "translation_mapped_only",
      "kernelVerified": false,
      "sourcePositionsValid": true,
      "originalInferenceVerified": false,
      "sourceEquivalenceCertified": false,
      "leanWitnessMarker": "source_step_7",
      "dependsOn": []
    },
    {
      "id": "source-8",
      "index": 8,
      "role": "inference",
      "start": 409,
      "end": 457,
      "sourceExcerpt": "∑_{i=1}^k xᵢ^m ≤ ∑_{i=1}^k (xᵢ−u+uxᵢ) = t−ku+ut。",
      "status": "translation_mapped_only",
      "kernelVerified": false,
      "sourcePositionsValid": true,
      "originalInferenceVerified": false,
      "sourceEquivalenceCertified": false,
      "leanWitnessMarker": "source_step_8",
      "dependsOn": []
    },
    {
      "id": "source-9",
      "index": 9,
      "role": "inference",
      "start": 480,
      "end": 522,
      "sourceExcerpt": "对任意 k<i≤n，由于 0≤xᵢ≤u<1，m≥2，有 xᵢ^(m−1)≤xᵢ≤u。",
      "status": "translation_mapped_only",
      "kernelVerified": false,
      "sourcePositionsValid": true,
      "originalInferenceVerified": false,
      "sourceEquivalenceCertified": false,
      "leanWitnessMarker": "source_step_9",
      "dependsOn": []
    },
    {
      "id": "source-10",
      "index": 10,
      "role": "inference",
      "start": 523,
      "end": 545,
      "sourceExcerpt": "两边乘以非负数 xᵢ，得 xᵢ^m≤uxᵢ。",
      "status": "translation_mapped_only",
      "kernelVerified": false,
      "sourcePositionsValid": true,
      "originalInferenceVerified": false,
      "sourceEquivalenceCertified": false,
      "leanWitnessMarker": "source_step_10",
      "dependsOn": []
    },
    {
      "id": "source-11",
      "index": 11,
      "role": "inference",
      "start": 546,
      "end": 583,
      "sourceExcerpt": "故 ∑_{i=k+1}^n xᵢ^m ≤ u∑_{i=k+1}^n xᵢ。",
      "status": "translation_mapped_only",
      "kernelVerified": false,
      "sourcePositionsValid": true,
      "originalInferenceVerified": false,
      "sourceEquivalenceCertified": false,
      "leanWitnessMarker": "source_step_11",
      "dependsOn": []
    },
    {
      "id": "source-12",
      "index": 12,
      "role": "inference",
      "start": 584,
      "end": 607,
      "sourceExcerpt": "当 n=k 时，上述两边均视为零，结论仍成立。",
      "status": "translation_mapped_only",
      "kernelVerified": false,
      "sourcePositionsValid": true,
      "originalInferenceVerified": false,
      "sourceEquivalenceCertified": false,
      "leanWitnessMarker": "source_step_12",
      "dependsOn": []
    },
    {
      "id": "source-13",
      "index": 13,
      "role": "inference",
      "start": 631,
      "end": 758,
      "sourceExcerpt": "∑_{i=1}^n xᵢ^m\n= ∑_{i=1}^k xᵢ^m + ∑_{i=k+1}^n xᵢ^m\n≤ t−ku+ut + u∑_{i=k+1}^n xᵢ\n= t−ku+u(t+∑_{i=k+1}^n xᵢ)\n= t−ku+u∑_{i=1}^n xᵢ。",
      "status": "translation_mapped_only",
      "kernelVerified": false,
      "sourcePositionsValid": true,
      "originalInferenceVerified": false,
      "sourceEquivalenceCertified": false,
      "leanWitnessMarker": "source_step_13",
      "dependsOn": []
    },
    {
      "id": "source-14",
      "index": 14,
      "role": "inference",
      "start": 776,
      "end": 821,
      "sourceExcerpt": "由题设 ∑_{i=1}^n xᵢ≤k，又 u≥0，所以 u∑_{i=1}^n xᵢ≤uk。",
      "status": "translation_mapped_only",
      "kernelVerified": false,
      "sourcePositionsValid": true,
      "originalInferenceVerified": false,
      "sourceEquivalenceCertified": false,
      "leanWitnessMarker": "source_step_14",
      "dependsOn": []
    },
    {
      "id": "source-15",
      "index": 15,
      "role": "inference",
      "start": 828,
      "end": 874,
      "sourceExcerpt": "∑_{i=1}^n xᵢ^m≤t−ku+u∑_{i=1}^n xᵢ≤t−ku+uk=t<1。",
      "status": "translation_mapped_only",
      "kernelVerified": false,
      "sourcePositionsValid": true,
      "originalInferenceVerified": false,
      "sourceEquivalenceCertified": false,
      "leanWitnessMarker": "source_step_15",
      "dependsOn": []
    },
    {
      "id": "source-16",
      "index": 16,
      "role": "inference",
      "start": 875,
      "end": 902,
      "sourceExcerpt": "这与已知条件 ∑_{i=1}^n xᵢ^m≥1 矛盾。",
      "status": "translation_mapped_only",
      "kernelVerified": false,
      "sourcePositionsValid": true,
      "originalInferenceVerified": false,
      "sourceEquivalenceCertified": false,
      "leanWitnessMarker": "source_step_16",
      "dependsOn": []
    },
    {
      "id": "source-17",
      "index": 17,
      "role": "inference",
      "start": 903,
      "end": 933,
      "sourceExcerpt": "因此原假设不成立，必有 ∑_{i=1}^k xᵢ≥1。证毕。",
      "status": "translation_mapped_only",
      "kernelVerified": false,
      "sourcePositionsValid": true,
      "originalInferenceVerified": false,
      "sourceEquivalenceCertified": false,
      "leanWitnessMarker": "source_step_17",
      "dependsOn": []
    }
  ],
