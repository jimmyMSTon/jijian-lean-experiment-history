class LeanRunner:
    def __init__(self, settings: Settings):
        self.settings = settings
        self.scheduler = LeanProcessScheduler(settings.data_dir / "lean-process-slots",
                                              settings.lean_parallelism)
        self.supervisor = LeanProcessSupervisor()
        self.metrics = {"processCount": 0, "elapsedSeconds": 0.0,
                        "activeProcessGroups": 0}

    async def close(self) -> None:
        await self.supervisor.terminate_all()

    def executable(self) -> str | None:
        configured = self.settings.lean_lake
        if Path(configured).is_file():
            return str(Path(configured).resolve())
        return shutil.which(configured)

    def sandbox_mode(self) -> str | None:
        configured = self.settings.lean_sandbox
        if configured == "trusted-local":
            return configured
        if configured in ("auto", "macos") and platform.system() == "Darwin" and Path("/usr/bin/sandbox-exec").exists():
            return "macos"
        if configured in ("auto", "bubblewrap") and platform.system() == "Linux" and shutil.which("bwrap"):
