"""Source-faithful proof compilation by immutable skeleton and local tactic holes.

Unlike a second whole-proof generation, a failing proof can be translated in
source-indexed pieces. Each piece is inserted at one compiler-owned exact
location. The assembled proof has no placeholders and is checked by the SAME
independent Kernel and source-fidelity pipeline as a whole-model candidate.
No intermediate result is a theorem, certificate, or original-proof verdict.
"""
from __future__ import annotations

import hashlib
import re
import textwrap
from pydantic import BaseModel, ConfigDict, Field
from .errors import AppError
from .lean_first_local_support import invalid_translation


class LeanProofScaffold(BaseModel):
    model_config = ConfigDict(extra='forbid')
    complete: bool
    proofTemplate: str = Field(description='An overall Lean by-term with source_step_i declarations, each authored step proved by exactly one JJ_SOURCE_HOLE_i tactic placeholder, plus a final proof goal conclusion. Do not use sorry.')
    unsupportedOriginalSteps: list[str] = Field(default_factory=list)


class LeanSourceHoleFill(BaseModel):
    model_config = ConfigDict(extra='forbid')
    index: int = Field(ge=0)
    complete: bool
    tacticCode: str = Field(description='ONLY the tactic sequence, no by prefix, that proves the existing source_step_i declaration in its frozen context')
    limitations: list[str] = Field(default_factory=list)


class LeanSourceHoleFillBatch(BaseModel):
    model_config = ConfigDict(extra='forbid')
    fragments: list[LeanSourceHoleFill] = Field(description='Source-indexed tactic fragments, no rewrite of the fixed proof scaffold; return incomplete where the author supplied insufficient reasoning')


BATCH_FILL_PROMPT = """你是原稿来源定位的 Lean 4 tactic 局部翻译器。
给定锁定原题和已经生成的、不允许改写的 Lean proofTemplate，按 sourceSteps 中原作者的数学理由
返回 fragments，每项仅给原稿一个步骤的 index、complete、tacticCode、limitations。
不能改变 proofTemplate、原证明路线、作用域或前提；不能额外添加数学结论或用 True 占位。
每个完整的 tacticCode 不带 by 顶层前缀，只放相应 JJ_SOURCE_HOLE_i 的 tactic body。
可根据前序已建立的 source_step_i 编码依赖、使用确实安装的 Lean Mathlib API。
任何一个未能忠实实现的步骤 complete=false，不得用 sorry、admit、axiom、unsafe、native_decide。
此时模型输出不是证明，整篇组合以后还要独立 Kernel 认证和来源核查。"""


SCAFFOLD_PROMPT = """你是 Lean 4/Mathlib 原证明结构编译器，不是解题者。
整篇证明翻译失败后，将用户现成的证明转化为一个可逐段实现的原稿顺序证明模板。
lockedFormalStatement 必须完整不变。proofTemplate 从 by 起，保留全部作者实质推理。
对每个 sourceSteps[i]，必须恰好有一个非平凡的 `have source_step_i : <精确原稿数学断言> := by`
并且其 tactic body 必须是仅含 `JJ_SOURCE_HOLE_i` 的单独一行，作为受控填充位置。
定理的变量绑定、反证、归纳、分情形可在模板中如实嵌套；末尾必须沿作者证明得出原题结论。
其他部分可放原稿明确给出的定义和惯常 Lean 语法，但不得创造未经作者证明的数学假设。
不得修改题目、变更推理路线、删除任何步骤、以 True 占位、使用 sorry/admit/axiom/unsafe/native_decide。
这里的模板尚不能证明任何命题，complete 仅指模板结构具备全部对应位置。
如果无法表达原稿作用域或某一来源步骤，complete=false 并注明原因。"""

FILL_PROMPT = """你只把原稿一个已有数学步骤转写成它在 Lean 证明模板中对应的 tacticCode。
原稿整题、lockedFormalStatement、have source_step_i 的命题及 proofTemplate 不允许改写。
仅返回 index、complete、tacticCode、limitations；tacticCode 是不带顶层 by 的局部 Lean tactic 列表。
依据 originalSourceStep 的真实数学理由和已有环境 availablePrefixCode，引用已经得到的事实。
不得用未建立的事实或作者未写出的关键数学推理代替原稿；可用 Mathlib 和基础 tactic
编码符号、求和、索引和类型转换；没有足够信息时 complete=false，列出限制，不编造证明。
模型返回的片段不等于 Lean 证书；只有最终完整组装、来源步骤校验和 Kernel 重放成功才算形式验证。
不得使用 sorry/admit/axiom/unsafe/native_decide、引入顶层 theorem/import/namespace、改写原命题。"""


HOLE_LINE = re.compile(r'(?m)^([ \t]*)JJ_SOURCE_HOLE_(\d+)[ \t]*$')



def normalize_source_scaffold_wrapper(template: str, locked_statement: str,
                                      count: int) -> tuple[str, list[str]]:
    """Recover theorem wrappers and 1-based labels without changing the proof.

    A model may emit a whole theorem declaration instead of a ``by`` term.
    Strip only the declaration header, preserving the authored proof body. The
    caller checks that body against ``locked_statement`` in the fresh Kernel;
    the wrapper's proposition is never used as the user's goal. Unwrap only a
    body containing every expected source marker, either with unique holes or
    as an already-filled proof term. No assumptions, goals, or tactics are added.
    """
    current = template
    operations: list[str] = []
    header = re.match(r'\A(?:theorem|lemma)[ 	]+[A-Za-z_][A-Za-z_0-9.]*[ 	]*:[ 	]*', current)
    if header is not None:
        suffix = current[header.end():]
        # A type expression can itself contain ``:= by``. Try separators in
        # order and accept only a body with the complete expected marker/hole
        # structure. A proposition mismatch is still checked against the
        # unchanged locked goal by Lean before any certificate is issued.
        for separator in re.finditer(r':=\s*(by\b)', suffix):
            body = suffix[separator.start(1):]
            body_markers = [int(v) for v in re.findall(
                r'\bhave[ \t]+source_step_(\d+)[ \t]*:', body)]
            body_holes = [int(v) for v in re.findall(
                r'\bJJ_SOURCE_HOLE_(\d+)\b', body)]
            zero_based = list(range(count))
            one_based = list(range(1, count + 1))
            complete_index_sets = (
                body_markers == zero_based and
                (sorted(body_holes) == zero_based or not body_holes)
                or body_markers == one_based and
                (sorted(body_holes) == one_based or not body_holes))
            if (len(body_markers) == count
                    and complete_index_sets):
                declared_statement = suffix[:separator.start()].strip()
                current = body
                operations.append(
                    'unwrap_theorem_with_exact_locked_statement'
                    if declared_statement == locked_statement else
                    'unwrap_theorem_wrapper_compile_against_locked_goal')
                break
    markers = [int(v) for v in re.findall(
        r'\bhave[ 	]+source_step_(\d+)[ 	]*:', current)]
    holes = [int(v) for v in re.findall(r'\bJJ_SOURCE_HOLE_(\d+)\b', current)]
    referenced = [int(v) for v in re.findall(r'\bsource_step_(\d+)\b', current)]
    expected = list(range(1, count + 1))
    if (markers == expected and sorted(holes) == expected
            and referenced and all(1 <= n <= count for n in referenced)):
        current = re.sub(r'\b(source_step_|JJ_SOURCE_HOLE_)(\d+)\b',
                         lambda m: m.group(1) + str(int(m.group(2)) - 1), current)
        operations.append('translate_complete_one_based_source_indices')
    return current, operations


def scaffold_issue(template: str, count: int, validate_markers) -> str | None:
    if not template.lstrip().startswith('by'):
        return 'scaffold_not_a_by_expression'
    if invalid_translation('True', template):
        return 'scaffold_forbidden_declaration_or_command'
    seen = list(HOLE_LINE.finditer(template))
    numbers = [int(m.group(2)) for m in seen]
    if len(numbers) != count or set(numbers) != set(range(count)):
        return 'source_holes_missing_duplicated_or_out_of_range'
    # A hole can only occur inside its own author-marked have := by. No other
    # occurrence of any hole token may hide inside string/comments/other code.
    if sorted(re.findall(r'\bJJ_SOURCE_HOLE_(\d+)\b', template)) != sorted(map(str, range(count))):
        return 'non_tactic_placeholder_occurrence'
    for match in seen:
        prefix = template[:match.start()]
        # The exact parent statement starts on a previous line. The section
        # following an owned have marker is restricted to whitespace before
        # the placeholder; no untrusted mini proof may be smuggled in there.
        # The nearest source have with strictly smaller indentation is the
        # syntactic parent, even when a nested authored proof already introduced
        # further source_step declarations inside its own proof body.
        markers = list(re.finditer(
            r'(?m)^([ \t]*)(?:·\s*)?have\s+source_step_(\d+)\s*:', prefix))
        parents = [m for m in markers if len(m.group(1).expandtabs(2)) < len(match.group(1).expandtabs(2))]
        if not parents or int(parents[-1].group(2)) != int(match.group(2)):
            return 'hole_does_not_match_author_step'
        owner = parents[-1]
        # The author's statement must provide an actual by proof body; the
        # following source step can be nested inside the previous one.
        following = prefix[owner.end():]
        if not re.search(r':=\s*by(?:[ \t]|\n|$)', following):
            return 'hole_not_inside_owned_by_declaration'
    return validate_markers(template, count)


def diagnostic_open_proof(template: str) -> str:
    """Temporary elaboration only: unsolved fragment bodies are local `sorry`.

    NEVER pass this string to check_many/whole Kernel. It is excluded from
    persisted proofTerm, proof certification and model-supplied real patches.
    """
    return HOLE_LINE.sub(lambda m: m.group(1)+'all_goals sorry',template)


def fill_hole(template: str, index: int, tactic_code: str) -> tuple[str | None, str | None]:
    matches = [m for m in HOLE_LINE.finditer(template) if int(m.group(2)) == index]
    if len(matches) != 1:
        return None, 'hole_not_unique_or_missing'
    if not tactic_code.strip() or tactic_code.lstrip().startswith('by'):
        return None, 'empty_or_nested_by_tactic_body'
    if invalid_translation('True', 'by\n' + tactic_code):
        return None, 'invalid_or_forbidden_tactic_body'
    if re.search(r'\bJJ_SOURCE_HOLE_\d+\b', tactic_code):
        return None, 'placeholder_in_replacement'
    m = matches[0]
    indent = m.group(1)
    # Only the exact hole line is replaceable; authored statements, binding
    # structure, previously successful fragment text and remaining holes fixed.
    lines = textwrap.dedent(tactic_code.strip('\n')).splitlines()
    replacement = '\n'.join(indent + line for line in lines)
    return template[:m.start()] + replacement + template[m.end():], None


async def assemble_source_locked_proof(*, source: str, source_sha: str, statement: str,
                                       steps: list[dict], prior_errors: list[str],
                                       provider, validate_markers, emit=None,
                                       verified_declarations: list[dict] | None = None,
                                       runner=None) -> dict:
    """No arbitrary step count/length gates. Always return uncercertified candidate.

    Stop on a real missing source step or provider failure; leave existing
