RUNTIME_PROTOCOL = "jj_export:nonce:name:type:proof"
RUNTIME_MODULES = ("Wire", "Export", "Audit", "FiniteCounting", "FiniteSums")


def _runtime_attestation(project: Path, expected_fingerprint: str | None = None) -> tuple[bool, str | None]:
    """Check the immutable runtime marker and the exact compiled wire modules.

    A present Audit.olean alone is not evidence that it matches the runner's
    four-argument export protocol. Packaged builds also provide the source
    fingerprint they prepared; local prepared runtimes still get their lock
    file and compiled-module hashes checked.
    """
    marker_path = project / ".jijian-source-lock.json"
    try:
        marker = json.loads(marker_path.read_text(encoding="utf-8"))
    except (OSError, ValueError, TypeError):
        return False, "runtime_attestation_missing_or_invalid"
    fingerprint = marker.get("fingerprint")
    if not isinstance(fingerprint, str) or not fingerprint:
        return False, "runtime_fingerprint_missing"
    if expected_fingerprint and fingerprint != expected_fingerprint:
        return False, "runtime_source_fingerprint_mismatch"
    if marker.get("protocol") != RUNTIME_PROTOCOL:
        return False, "runtime_protocol_mismatch"
    recorded = marker.get("compiledModuleSha256")
    if not isinstance(recorded, dict):
        return False, "runtime_compiled_hashes_missing"
    actual = {}
    for module in RUNTIME_MODULES:
        path = project / f".lake/build/lib/lean/Jijian/{module}.olean"
        try:
            actual[module] = hashlib.sha256(path.read_bytes()).hexdigest()
        except OSError:
            return False, "runtime_compiled_module_missing"
    if any(recorded.get(module) != actual[module] for module in RUNTIME_MODULES):
        return False, "runtime_compiled_hash_mismatch"
    return True, fingerprint

@dataclass
class ProcessResult:
    returncode: int
    stdout: str
    stderr: str
    metrics: dict | None = None


def _memory_sample() -> dict:
    """Return Python's process high-water RSS in bytes."""
    scale = 1 if platform.system() == "Darwin" else 1024
    peak = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * scale
    return {"pythonPeakRssBytes": peak}


class LeanProcessSupervisor:
    """Tracks only child process groups created by this LeanRunner."""
    def __init__(self):
        self._lock = threading.RLock()
        self._processes: dict[int, asyncio.subprocess.Process] = {}

    def register(self, process: asyncio.subprocess.Process) -> None:
        with self._lock:
            self._processes[process.pid] = process
        configured = self.settings.lean_sandbox
        if configured == "trusted-local":
            return configured
        if configured in ("auto", "macos") and platform.system() == "Darwin" and Path("/usr/bin/sandbox-exec").exists():
            return "macos"
        if configured in ("auto", "bubblewrap") and platform.system() == "Linux" and shutil.which("bwrap"):
            return "bubblewrap"
        return None

    def info(self) -> dict:
        project = self.settings.lean_project
        toolchain = project / "lean-toolchain"
        manifest = project / "lake-manifest.json"
        compiled = project / ".lake/build/lib/lean/Jijian/Audit.olean"
        executable = self.executable()
        runtime_integrity, runtime_attestation = _runtime_attestation(
            project, os.getenv("JJ_RUNTIME_SOURCE_FINGERPRINT"))
        return {"configured": bool(executable), "executableFound": bool(executable),
            "projectFound": project.is_dir(), "runtimeBuilt": bool(compiled.is_file() and runtime_integrity),
            "runtimeIntegrity": runtime_integrity,
            "runtimeAttestation": runtime_attestation,
            "sandbox": self.sandbox_mode(), "isolated": self.sandbox_mode() in ("macos", "bubblewrap"),
            "ready": bool(executable and compiled.is_file() and runtime_integrity and self.sandbox_mode()),
            "toolchain": toolchain.read_text().strip() if toolchain.exists() else None,
            "manifestSha256": hashlib.sha256(manifest.read_bytes()).hexdigest() if manifest.exists() else None,
            "liveTestedInThisDistribution": False}

    def _read_paths(self) -> list[Path]:
        executable = self.executable()
        paths = [Path(p) for p in ("/usr", "/bin", "/lib", "/lib64", "/System", "/Library", "/private/etc", "/etc", "/opt/homebrew", "/usr/local") if Path(p).exists()]
        paths.append(self.settings.lean_project.resolve())
        if executable:
            actual = Path(executable).resolve()
            paths.append(actual.parent.parent)
        paths.extend(Path(p).resolve() for p in self.settings.lean_read_paths)
        return list(dict.fromkeys(paths))

    def command(self, workspace: Path, file: Path) -> tuple[list[str], dict]:
        executable = self.executable()
        if not executable:
            raise AppError("LEAN_NOT_INSTALLED", "未找到 Lean/Lake；没有运行任何模拟验证", 503)
        mode = self.sandbox_mode()
        if not mode:
            raise AppError("LEAN_ISOLATION_UNAVAILABLE", "当前运行环境缺少配置的进程隔离能力；Lean 候选程序尚未执行", 503)
        # 实际调用固定工具链的 lake；环境准备脚本把 LEAN_LAKE 指向该二进制，避免自动下载工具链。
        # Execute the prepared Lean binary directly. Lake's environment loading can
        # attempt dependency updates when host Git URL rewrites are absent in the
        # clean sandbox; validation must never clone or mutate installed Mathlib.
        lean = Path(executable).parent / "lean"
        if not lean.is_file():
            raise AppError("LEAN_NOT_INSTALLED", "固定 Lake 工具链旁没有 Lean 二进制，请准备运行环境", 503)
        argv = [str(lean), "--json", str(file)]
        env = clean_environment(workspace)
        manifest = self.settings.lean_project / "lake-manifest.json"
        packages = json.loads(manifest.read_text()) if manifest.is_file() else {"packages": []}
        libraries = [self.settings.lean_project / ".lake/build/lib/lean"]
        for package in packages.get("packages", []):
            libraries.append(self.settings.lean_project / packages.get("packagesDir", ".lake/packages") / package["name"] / ".lake/build/lib/lean")
        env["LEAN_PATH"] = os.pathsep.join(str(p.resolve()) for p in libraries)
        paths = self._read_paths()
        if mode == "trusted-local":
            return argv, env
        if mode == "macos":
            quote = lambda p: json.dumps(str(p), ensure_ascii=False)
            reads = " ".join(f"(subpath {quote(p)})" for p in paths)
            # macOS getcwd/Lake resolve directory ancestors; allow listing only these
            # exact directories, never recursive access to user files or server secrets.
            ancestors = set(workspace.parents) | set(self.settings.lean_project.resolve().parents)
            reads += " " + " ".join(f"(literal {quote(p)})" for p in sorted(ancestors))
            profile = ("(version 1)(deny default)(allow process*)(allow sysctl-read)"
                "(allow mach-lookup)(allow file-read-metadata)(allow file-read* (literal \"/\"))"
                f"(allow file-read* {reads} (subpath {quote(workspace)}))"
                f"(allow file-write* (subpath {quote(workspace)}) (literal \"/dev/null\"))"
                "(allow file-read* (literal \"/dev/null\") (literal \"/dev/urandom\") (literal \"/dev/random\"))(deny network*)")
            return ["/usr/bin/sandbox-exec", "-p", profile, *argv], env
        command = [shutil.which("bwrap") or "bwrap", "--unshare-all", "--die-with-parent", "--new-session"]
