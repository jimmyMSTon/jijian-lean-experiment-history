    async def diagnose_incomplete_source_proofs(self, statement: str,
                                               snapshots: list[tuple[int, str]]) -> list[dict]:
        """Batch scoped Lean elaboration of partially filled authored proofs.

        All unfilled holes must be substituted with temporary `sorry` by the
        caller. Nothing from this method can become a certificate: only the
        separate check_many + independent fresh Kernel replay can do that.
        One real isolated Lean process amortizes Mathlib startup for every
        source fragment, while retaining accurate line/column diagnostics.
        """
        if not snapshots:
            return []
        header = ('import Mathlib\nimport Jijian\n'
                  'set_option autoImplicit false\nset_option Elab.async false\n')
        source_parts = [header]
        current_line = len(header.splitlines()) + 1
        positions: list[tuple[int, int, int, bool]] = []
        for index, temporary_proof in snapshots:
            chunk = f'example : ({statement}) :=\n{temporary_proof}\n'
            proof_start = current_line + 1
            proof_end = current_line + len(chunk.splitlines())
            positions.append((index, proof_start, proof_end,
                              'sorry' in temporary_proof))
            source_parts.append(chunk)
            current_line += len(chunk.splitlines())
        result = await self._stage(''.join(source_parts))
        diagnostics = parse_diagnostics(result.stdout, result.stderr,
            step_id='__diagnostic_only_source_fragment_batch__',source_refs=[])
        records = {idx: {'index':idx, 'status':'diagnostics_only',
            'diagnosticOnly':True,'kernelVerified':False,'certificate':None,
            'ephemeralOnly':True,'errors':[],
            'usesSorryForUnfinishedFragments': has_sorry,
            'runtimeReturnCode':result.returncode}
            for idx,_,_,has_sorry in positions}
        global_errors=[]
        for row in diagnostics:
            if row.get('severity')!='error':
                continue
            position = row.get('leanPosition') or {}
            line = position.get('line') if isinstance(position,dict) else None
            matched = next(((idx,start) for idx,start,end,_ in positions
                            if isinstance(line,int) and start <= line <= end),None)
            if matched is None:
                global_errors.append(row)
            else:
                idx,start=matched
                records[idx]['errors'].append({**row,'proofLine':line-start+1,
                    'proofLineMapping':'ephemeral_plain_lean_source'})
        if global_errors:
            for record in records.values():
                record['errors'].extend({**d,'proofLineMapping':'global_diagnostic'}
                                        for d in global_errors)
        return [records[idx] for idx,_,_,_ in positions]

    async def diagnose_incomplete_source_proof(self, statement: str, temporary_proof: str) -> dict:
        """Compatibility wrapper for one ephemeral diagnostic-only fragment."""
        return (await self.diagnose_incomplete_source_proofs(
            statement, [(0,temporary_proof)]))[0]

    async def lookup_declaration(self, name: str) -> dict:
        # Names only, never an arbitrary Lean expression / command or user import path.
        ident = r"(?:[^\W\d]|_)[\w'!?]*(?:\.(?:[^\W\d]|_)[\w'!?]*)*"
        if not re.fullmatch(ident, name):
            raise AppError("INVALID_DECLARATION_NAME", "查询应为一个 Lean 声明名称", 422)
        source = ("import Mathlib\nimport Jijian.FiniteCounting\nimport Jijian.FiniteSums\nset_option autoImplicit false\n"
                  "set_option pp.universes true\nset_option pp.fullNames true\n"
                  f"#check @{name}\n")
        result = await self._stage(source)
        diagnostics = parse_diagnostics(result.stdout, result.stderr, step_id="__library_lookup__", source_refs=[])
        errors = [d for d in diagnostics if d["severity"] == "error"]
        messages = [d["message"] for d in diagnostics if isinstance(d.get("message"), str) and d["severity"] in ("information", "info")]
        # A zero exit code alone is insufficient; retain the actual type report.
        reports = [m for m in messages if name in m and ":" in m]
        found = result.returncode == 0 and not errors and bool(reports)
        return {"name": name, "found": found,
                "signature": "\n".join(reports) if found else None,
                "status": "lean_checked" if found else "not_resolved",
                "diagnostics": diagnostics, "runtime": self.info(),
                "requiredImport": "Mathlib", "minimalImportDetermined": False}
