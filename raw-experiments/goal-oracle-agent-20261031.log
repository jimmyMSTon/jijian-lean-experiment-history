            'originalSource':source,'sourceSha256':source_sha,
            'lockedFormalStatement':statement,'sourceSteps':steps,
            'previousUnsupportedAuthorSteps':prior_errors,
            'installedLeanVerifiedDeclarations':verified_declarations or []})
    except AppError as exc:
        report['status']='scaffold_provider_unavailable';report['serviceError']=exc.payload();return report
    except re.error as exc:
        # Do not turn malformed generated math/code into an opaque INTERNAL_ERROR
        # after a paid model request. Preserve the failure reason as diagnostics.
        report['status']='scaffold_regex_processing_error'
        report['errorType']='re.error'
        report['regexError']=str(exc)
