RESULT goal_expression_elaborated_source_unconfirmed LEN 1160 UNRESOLVED [] LEAN elaborated CANDIDATE let Board : ℕ → Type := fun n => Fin n → Fin n → Bool; let checkerboard : (n : ℕ) → Board n := fun n i j => decide ((i.val + j.val) % 2 = 0); let SwapOp : ℕ → Type := fun n => Bool × (Fin n × Fin n); let applyOp : (n : ℕ) → SwapOp n → Board n → Board n := fun n op b => fun r c => if op.1 then (if r = op.2.1 then b op.2.2 c else if r = op.2.2 then b op.2.1 c else b r c) else (if c = op.2.1 then b r op.2.2 else if c = op.2.2 then b r op.2.1 else b r c); let applyOps : (n : ℕ) → List (SwapOp n) → Board n → Board n := fun n ops b => List.foldl (fun b op => applyOp n op b) b ops; let Reachable : (n : ℕ) → Board n → Prop := fun n b => ∃ ops : List (SwapOp n), applyOps n ops (checkerboard n) = b; let Restoring : (n : ℕ) → Board n → ℕ → Prop := fun n b k => ∃ ops : List (SwapOp n), ops.length = k ∧ applyOps n ops b = checkerboard n; let MinCost : (n : ℕ) → Board n → ℕ → Prop := fun n b k => Restoring n b k ∧ ∀ m : ℕ, Restoring n b m → k ≤ m; let answer : ℕ → ℕ := fun n => if n % 2 = 0 then n / 2 else n - 1; ∀ n : ℕ, 0 < n → (∀ b : Board n, Reachable n b → ∃ k : ℕ, MinCost n b k ∧ k ≤ answer n) ∧ (∃ b : Board n, Reachable n b ∧ MinCost n b (answer n))
