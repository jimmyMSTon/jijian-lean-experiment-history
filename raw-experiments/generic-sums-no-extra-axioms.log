'Jijian.GenericFiniteSums.sum_range_telescope' depends on axioms: [propext, Classical.choice, Quot.sound]
'Jijian.GenericFiniteSums.sum_range_prefix_step' depends on axioms: [propext, Classical.choice, Quot.sound]
'Jijian.GenericFiniteSums.square_difference_le' depends on axioms: [propext, Classical.choice, Quot.sound]
'Jijian.GenericFiniteSums.sum_square_differences_le' depends on axioms: [propext, Classical.choice, Quot.sound]
Jijian.GenericFiniteSums.sum_range_telescope : ∀ (f : ℕ → ℝ) (n : ℕ),
  ∑ i ∈ Finset.range n, (f (i + 1) - f i) = f n - f 0
Jijian.GenericFiniteSums.sum_square_differences_le : ∀ (f : ℕ → ℝ) (n : ℕ),
  ∑ i ∈ Finset.range n, (f (i + 1) - f i) ^ 2 ≤ 2 * ∑ i ∈ Finset.range n, (f (i + 1) ^ 2 + f i ^ 2)
